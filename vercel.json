{
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "confgive.thehope.co"
                }
            ],
            "destination": "https://giving.thehope.co/$1",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/.well-known/(.*)",
            "destination": "/.well-known/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
